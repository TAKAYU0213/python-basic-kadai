   ],
   "source": [
    "# 上辺：10cm\n",
    "# 下辺：20cm\n",
    "# 高さ：5cm\n",
    "# 公式：台形の面積 =（上辺＋下辺）× 高さ ÷ 2\n",
    "\n",
    "upper_base = 10\n",
    "lower_base = 20\n",
    "height = 5\n",
    "surface_area = (upper_base + lower_base) * height / 2\n",
    "\n",
    "print(f\"台形の面積は{surface_area}cm²です。\")"
   ]
  }
 ],
